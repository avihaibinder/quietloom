{
  "name": "rn",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.9",
    "expo-keep-awake": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-audio-api": "^0.13.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:optimized": "expo run:android --variant debugOptimized",
    "android:release": "expo run:android --variant release",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-test-env.mjs",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:bundle": "vitest run --config vitest.bundle.config.mts",
    "fix-truststore": "powershell -ExecutionPolicy Bypass -File scripts/fix-truststore.ps1"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-google-mobile-ads"
      ],
      "//": "TEMPORARY. react-native-google-mobile-ads 16.4 needs Kotlin 2.3 (via play-services-ads 25.3+) and Expo SDK 57 ships 2.1.20, so its Kotlin will not compile. The app degrades to no ads and still runs. Remove this exclusion (and restore the plugin block in app.json) once the Kotlin version is raised - see HANDOFF.md \"BLOCKER: the ad SDK does not build on Expo SDK 57\"."
    }
  }
}
