<?xml version="1.0" encoding="utf-8"?>
<!--
    Quietloom mark: a crescent moon with three sound waves drifting off it.
    Adaptive-icon geometry — the safe zone is the middle 72x72dp of the 108x108
    viewport, so everything stays roughly between 26 and 82 on both axes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crescent: a disc with a second, offset disc subtracted via evenOdd. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M41.5,29.5 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 M50.5,22.5 a16.5,16.5 0 1,0 33,0 a16.5,16.5 0 1,0 -33,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42" android:startY="12"
                android:endX="78" android:endY="48"
                android:type="linear">
                <item android:offset="0" android:color="#FFF3F6FF" />
                <item android:offset="1" android:color="#FFB9C6EF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Three arcs, brightest nearest the moon: the generated soundscape. -->
    <path
        android:pathData="M34,58 q20,-9 40,0"
        android:strokeColor="#FF9FB4F0"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M30,71 q24,-11 48,0"
        android:strokeColor="#B37E96DC"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M27,84 q27,-13 54,0"
        android:strokeColor="#66657FC4"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
</vector>
